{
  "name": "chrome-music-lab",
  "version": "1.0.0",
  "description": "Chrome Music Lab unified project for Vercel",
  "main": "index.html",
  "scripts": {
    "build:webpack": "WP=$(pwd)/node_modules/.bin/webpack; ROOT_NM=$(pwd)/node_modules; set -e; for dir in arpeggios chords melodymaker pianoroll soundspinner; do echo \"Building $dir...\"; (cd \"$dir\" && NODE_PATH=\"$ROOT_NM\" \"$WP\" --bail --config webpack.config.js); done",
    "build:spectrogram": "node scripts/build-spectrogram.js",
    "build": "npm run build:webpack && npm run build:spectrogram"
  },
  "dependencies": {
    "a-big-triangle": "^1.0.2",
    "autoprefixer-loader": "^3.2.0",
    "binary-search-bounds": "^2.0.3",
    "brfs": "^1.4.0",
    "browserify": "^17.0.0",
    "css-loader": "^0.28.11",
    "domready": "^1.0.8",
    "file-loader": "^1.1.11",
    "gl-buffer": "^2.1.2",
    "gl-shader": "^4.0.5",
    "glsl-aastep": "^1.0.1",
    "html-loader": "^0.5.5",
    "imports-loader": "^0.8.0",
    "interval-tree-1d": "^1.0.3",
    "jade": "^1.11.0",
    "jquery": "^2.2.4",
    "jquery-knob": "^1.2.11",
    "jquery-mousewheel": "^3.1.13",
    "json-loader": "^0.5.7",
    "lodash": "^3.10.1",
    "midiconvert": "^0.4.2",
    "raw-loader": "^0.5.1",
    "sass": "^1.85.0",
    "sass-loader": "^6.0.7",
    "slick-carousel": "^1.8.1",
    "soundfont-player": "^0.4.0",
    "startaudiocontext": "^1.2.1",
    "style-loader": "^0.23.1",
    "teoria": "^2.5.0",
    "tinycolor2": "^1.6.0",
    "transform-loader": "^0.2.2",
    "tween.js": "^16.6.0",
    "url-loader": "^1.1.2",
    "webfontloader": "^1.6.28",
    "webpack": "^1.15.0"
  },
  "author": "",
  "license": "Apache-2.0"
}
